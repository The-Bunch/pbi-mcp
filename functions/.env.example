# Copy to functions/.env and fill in. Firebase loads this file at deploy time.
# Secrets do NOT go here — PBI_TENANT_ID, PBI_CLIENT_ID and PBI_CLIENT_SECRET
# live in Secret Manager (firebase functions:secrets:set ...).

# Required. The public origin of your server, no trailing slash.
# With Firebase Hosting this is https://<your-project-id>.web.app
PUBLIC_URL=https://your-project-id.web.app

# Optional. Comma-separated redirect URIs MCP clients may use. Defaults to
# Claude (claude.ai + claude.com) and loopback (http://localhost, http://127.0.0.1,
# any port) for desktop clients and the MCP Inspector.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1

# Optional. Only allow sign-ins from these email domains (comma-separated).
# ALLOWED_EMAIL_DOMAINS=example.com

# Optional. Hide the refresh tools so the server can only read.
# PBI_READ_ONLY=true

# Optional. Extra guidance appended to the query tools' descriptions, so the
# model knows where your good data lives. One line; keep it short and factual.
# PBI_DATASET_HINT=For current figures use the "Warehouse" dataset (ID ...). Key tables: fact_sales (one row per order), dim_customer.

# Optional. Log 200-char previews of Power BI responses. Leave off in production:
# responses are your data.
# DEBUG=false
