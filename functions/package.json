{
  "name": "pbi-mcp",
  "version": "1.0.0",
  "description": "A remote MCP server for Power BI, secured with Microsoft Entra ID and deployable to Firebase.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Bunch/pbi-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,hosting",
    "deploy": "npm test && firebase deploy --only functions,hosting",
    "logs": "firebase functions:log --only mcp"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "axios": "^1.7.0",
    "express": "^4.18.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
